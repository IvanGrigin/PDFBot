# Токен бота из @BotFather.
BOT_TOKEN=

# Минимальный остаток диска. При меньшем значении новые PDF не создаются.
MIN_FREE_GB=5

# Максимальный размер входного PDF при стандартном Telegram Bot API.
MAX_PDF_DOWNLOAD_MB=20

# Максимальное время сжатия одного PDF в секундах.
PDF_COMPRESS_TIMEOUT_SECONDS=180
